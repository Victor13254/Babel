# --- Base ---
PROJECT_NAME=Babel
ENV=prod
API_V1_PREFIX=/api

# El frontend ya no será http://localhost:5173,
# sino el dominio público de la EC2 *por HTTPS*
BACKEND_CORS_ORIGINS=["https://ec2-3-236-245-186.compute-1.amazonaws.com"]

# --- Seguridad ---
SECRET_KEY=CAMBIA_ESTA_CLAVE_POR_ALGO_LARGO_Y_UNICO
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# --- DB (Postgres en Docker) ---
POSTGRES_USER=babel
POSTGRES_PASSWORD=babelpwd
POSTGRES_DB=babel
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://babel:babelpwd@db:5432/babel

ADMIN_EMAIL=admin@babel.local
ADMIN_PASSWORD=admin

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- S3 / MinIO ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=babel-backups
S3_REGION=us-east-1
S3_USE_SSL=false
# Probablemente solo para uso interno / backups
S3_PUBLIC_BASE_URL=http://minio:9000/babel-backups
S3_PRESIGN_EXPIRES=900

# --- Frontend ---
# Aquí tu frontend usará esta base y luego añadirá /api/... donde toque
VITE_API_BASE=https://ec2-3-236-245-186.compute-1.amazonaws.com
