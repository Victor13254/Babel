# --- Base ---
PROJECT_NAME=Babel
ENV=dev
API_V1_PREFIX=/api
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# --- Seguridad ---
SECRET_KEY=cambiar_clave_secreta_test
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# --- DB (Postgres en Docker) ---
POSTGRES_USER=babel
POSTGRES_PASSWORD=babelpwd
POSTGRES_DB=babel
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://babel:babelpwd@db:5432/babel

# --admin db--
ADMIN_EMAIL=admin@babel.local
ADMIN_PASSWORD=admin

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- S3 / MinIO (para backups locales) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=babel-backups
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PUBLIC_BASE_URL=http://localhost:9000/babel-backups
S3_PRESIGN_EXPIRES= 900
# --- Frontend ---
VITE_API_BASE=http://localhost:8000
